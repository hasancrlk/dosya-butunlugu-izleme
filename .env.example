# FIM-Sentinel Configuration — copy to .env and edit.

# Database — PostgreSQL (recommended) or SQLite (dev)
FIM_DATABASE_URL=sqlite:///./fim_sentinel.db

# ── Security (REQUIRED) ────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FIM_API_KEY=change-me
FIM_HMAC_KEY=change-me-at-least-32-characters-long
# Directories the REST API is allowed to scan (JSON list)
FIM_ALLOWED_PATHS=["/watch"]

FIM_HASH_CHUNK_SIZE=65536
FIM_FOLLOW_SYMLINKS=false
FIM_LOG_LEVEL=INFO

# Docker Compose only
POSTGRES_USER=fim_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fim_sentinel
