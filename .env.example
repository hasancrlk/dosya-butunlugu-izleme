# FIM-Sentinel Configuration
# Copy to .env and edit as needed

# Database URL — PostgreSQL (recommended) or SQLite (fallback)
# FIM_DATABASE_URL=postgresql://fim_user:fim_pass@localhost:5432/fim_sentinel
FIM_DATABASE_URL=sqlite:///./fim_sentinel.db

# Hash chunk size in bytes (default: 65536 = 64 KB)
FIM_HASH_CHUNK_SIZE=65536

# Follow symbolic links during scan (default: false)
FIM_FOLLOW_SYMLINKS=false

# Log level
FIM_LOG_LEVEL=INFO
